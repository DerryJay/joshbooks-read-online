rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jayjay17112005@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Books collection: public read, admin write
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection: public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: owner read/write, admin read
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();

      // User favorites subcollection
      match /favorites/{bookId} {
        allow read, write: if isOwner(userId);
      }

      // User bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      // User reading progress subcollection
      match /reading_progress/{bookId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Admin lookup
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
